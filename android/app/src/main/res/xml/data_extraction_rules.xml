<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상. 제외 사유는 backup_rules.xml 참고.
     클라우드 백업과 기기 간 이전 양쪽 모두에서 제외한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
